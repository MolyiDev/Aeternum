{
	"name": "roblox-ts-game",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json"
	],
	"tree": {
		"$className": "DataModel",
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"$path": "out/server/ServerScriptService"
		},
		"ServerStorage": {
			"$className": "ServerStorage",
			"$path": "out/server/ServerStorage"
		},
		"ReplicatedFirst": {
			"$className": "ReplicatedFirst",
			"$path": "out/sharedFirst"
		},
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					}
				}
			},
			"$path": "out/shared"
		},
		"StarterGui": {
			"$className": "StarterGui",
			"$path": "out/client/StarterGui"
		},
		"StarterPack": {
			"$className": "StarterPack",
			"$path": "out/client/StarterPack"
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"$path": "out/client/StarterPlayer/StarterPlayerScripts"
			},
			"StarterCharacterScripts": {
				"$className": "StarterCharacterScripts",
				"$path": "out/client/StarterPlayer/StarterCharacterScripts"
			},
			"$path": "out/client/StarterPlayer"
		},
		"Workspace": {
			"$className": "Workspace",
			"$properties": {
				"FilteringEnabled": true
			}
		},
		"HttpService": {
			"$className": "HttpService",
			"$properties": {
				"HttpEnabled": true
			}
		},
		"SoundService": {
			"$className": "SoundService",
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}
